{
  "contractVersion": "aftermath-skills-v3.0.0-overlay-v1",
  "expectations": {
    "builderCode": {
      "allowedFields": [
        "integratorId",
        "integratorFee"
      ],
      "removedFields": [
        "integratorAddress",
        "takerFee",
        "maxTakerFee"
      ]
    },
    "candles": {
      "historyField": "resolution",
      "removedHistoryField": "intervalMs",
      "removedStreamPathTemplate": "/api/perpetuals/ws/market-candles/{market_id}/{interval_ms}",
      "resolutions": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "12h",
        "1d",
        "3d",
        "1w",
        "1mo"
      ],
      "streamPath": "/api/perpetuals/ws/updates",
      "subscriptionType": "marketCandles"
    },
    "canonicalSurfacePrefix": "/api/perpetuals/",
    "ccxtPendingOrders": {
      "accountField": "accountNumber",
      "marketField": "chId",
      "path": "/api/ccxt/myPendingOrders",
      "writeAccountField": "accountId",
      "writeAccountMeaning": "capability_object_id",
      "writePolicy": "deny"
    },
    "identifiers": {
      "ccxtWriteAccountId": "capability_object_id",
      "nativeAccountId": "numeric_bigint",
      "nativeBigIntWirePattern": "^[0-9]+n$"
    },
    "implementationStatus": {
      "builderCode": "not_implemented_blocked",
      "candles.history": "implemented_read_only",
      "candles.streamSubscription": "implemented_shape_only_no_network_client",
      "ccxt.pendingOrders": "implemented_read_only",
      "identifiers": "implemented_read_only",
      "isolatedMarginAllocation": "not_implemented_blocked",
      "preview": "parser_only_write_endpoints_blocked",
      "runtimeSafety.deadManAndSerialization": "not_implemented_blocked",
      "signingAndSubmit": "not_implemented_blocked",
      "slTp": "not_implemented_blocked"
    },
    "isolatedMargin": {
      "allocationRequired": true,
      "unallocatedCollateralProtectsPositions": false
    },
    "preview": {
      "http200MayContainError": true,
      "mustParseSuccessErrorUnion": true
    },
    "removedIntegratorRoutes": [
      "/api/perpetuals/integrator-vaults",
      "/api/perpetuals/transactions/create-integrator-vault",
      "/api/perpetuals/transactions/claim-integrator-vault-fees"
    ],
    "runtimeSafety": {
      "builtInDeadManSwitch": false,
      "heartbeatCancellationRequiredBeforeLive": true,
      "serializeCoinAndGasObjectOperations": true,
      "websocketReconnectSequence": [
        "reconnect",
        "refetch_snapshot",
        "atomic_replace",
        "resume_deltas"
      ]
    },
    "signing": {
      "ambiguousSubmitAction": "reconcile_before_retry",
      "neverSign": "transactionBytes",
      "sign": "signingDigest"
    },
    "slTp": {
      "allowedPriceFields": [
        "stopLossPrice",
        "takeProfitPrice"
      ],
      "removedPriceFields": [
        "stopLossIndexPrice",
        "takeProfitIndexPrice"
      ],
      "triggerPriceType": {
        "0": "index",
        "1": "book_mid",
        "2": "mark"
      }
    },
    "writePolicy": "deny"
  },
