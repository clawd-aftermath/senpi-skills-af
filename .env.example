# ─── Aftermath V2 runtime ────────────────────────────────────────────────────
# Copy to .env and fill in ONE value: AF_WALLET_ADDRESS. Everything else has a
# working default.
#
#   cp .env.example .env
#   $EDITOR .env                 # set AF_WALLET_ADDRESS
#   python3 -m aftermath_runtime doctor
#
# .env is gitignored. Never commit it.


# ─── The one required value ──────────────────────────────────────────────────

# Your Sui wallet ADDRESS. Not a private key, not a seed phrase.
#
# This runtime never reads, requests, derives, or stores a key. Signing is a
# caller-supplied callback and this repository ships without one, so there is
# nothing here that could spend from this wallet.
AF_WALLET_ADDRESS=


# ─── Gas: your choice, three modes ───────────────────────────────────────────

# sponsored  the Aftermath gas pool pays. You need NO SUI. (default)
# self       your own SUI pays.
# dynamic    another coin pays, routed through /api/dynamic-gas.
#
# `doctor` validates the active mode's prerequisites and fails with an
# actionable message. It never silently switches modes -- if you chose
# `sponsored` because you hold no SUI, quietly falling back to `self` would
# strand you.
AF_GAS_MODE=sponsored

# dynamic mode only: WHICH coin pays your gas. Required when AF_GAS_MODE=dynamic.
# Example (USDC on Sui mainnet):
# AF_GAS_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC
AF_GAS_COIN_TYPE=

# Gas budget in MIST, always set explicitly. Auto-estimation under-counts the
# storage cost of objects a transaction creates, which surfaces later as
# InsufficientGas on something that simulated fine. 50000000 MIST = 0.05 SUI.
AF_GAS_BUDGET_MIST=50000000


# ─── Arming: the single flag between observing and acting ────────────────────

# Every strategy in this repository ships DISABLED. With AF_ARMED unset, no
# transaction is built at all -- the adapter refuses before making a request.
#
# Setting AF_ARMED=1 allows transactions to be BUILT, previewed and inspected.
# It does NOT allow signing or submitting: no submit route appears in any
# transport allowlist, and there is no signer.
#
# Turnkey means "no wiring". It does not mean "trades on first run".
AF_ARMED=


# ─── Optional: sensible defaults you rarely need to change ───────────────────

# The API host. Defined exactly once in aftermath_runtime/config.py and
# overridable here. The default below is PRODUCTION MAINNET despite the
# hostname; the legacy aftermath host is retired and the runtime fails closed
# if you point it there.
# AF_API_BASE_URL=https://v2-preview.aftermath.finance

# Collateral coin type. Defaults to USDC on Sui mainnet. `doctor` verifies that
# markets actually exist for whatever you set.
# AF_COLLATERAL_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# Pin a specific perpetuals account. Leave unset for auto-discovery via
# POST /api/perpetuals/accounts/owned -- the turnkey path.
# AF_ACCOUNT_ID=

# Live network access. Both are off by default so importing the package, or
# running the tests, can never open a socket.
#   AFTERMATH_ALLOW_LIVE_READS=1   allows read + preview calls
#   AFTERMATH_ALLOW_TX_BUILD=1     additionally allows transaction BUILDING
# AFTERMATH_ALLOW_LIVE_READS=
# AFTERMATH_ALLOW_TX_BUILD=
